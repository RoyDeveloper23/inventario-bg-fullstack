{
  "ConnectionStrings": {
    "Postgres": ""
  },
  "Jwt": {
    "ClaveSecreta": "",
    "Emisor": "InventarioBg",
    "Audiencia": "InventarioBg",
    "MinutosExpiracion": 60
  },
  "Cors": {
    "Origins": [
      "http://localhost:4200"
    ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/inventario-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "shared": true
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  },
  "AllowedHosts": "*"
}
